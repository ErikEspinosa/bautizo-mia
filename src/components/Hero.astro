---
import { invitation } from "../data/invitation.js";

const { name } = invitation.child;
---

<section class="hero">

  <div
    class="hero__image"
    data-image-reveal
  >
    <img
      src="/images/hero.jpg"
      alt={`Fotografía de ${name}`}
    />
  </div>

  <div class="hero__veil"></div>

  <div class="hero__ornament hero__ornament--top">
    <span></span>
  </div>

  <div class="hero__content">

    <p
      class="hero__eyebrow"
      data-reveal
    >
      Bautizo
    </p>

    <h1 data-reveal style="--reveal-delay: 120ms">
      {name}
    </h1>

    <div
      class="hero__line"
      data-reveal
      style="--reveal-delay: 220ms"
    ></div>

    <p
      class="hero__date"
      data-reveal
      style="--reveal-delay: 300ms"
    >
      24 · OCTUBRE · 2026
    </p>

  </div>

  <a
    href="#invitacion"
    class="hero__scroll"
    aria-label="Descubrir invitación"
  >
    <span>Descubre</span>
    <i></i>
  </a>

</section>

<style lang="scss">
  .hero {
    position: relative;

    min-height: 100svh;
    overflow: hidden;

    display: flex;
    align-items: flex-end;
    justify-content: center;

    background: var(--color-background);
  }

  .hero__image {
    position: absolute;
    inset: 0;

    overflow: hidden;
  }

  .hero__image img {
    width: 100%;
    height: 100%;

    object-fit: cover;

    animation: heroZoom 12s ease-out forwards;
  }

  .hero__veil {
    position: absolute;
    inset: 0;

    background:
      linear-gradient(
        to bottom,
        rgba(248, 245, 239, 0.05) 20%,
        rgba(248, 245, 239, 0.18) 45%,
        rgba(248, 245, 239, 0.9) 82%,
        var(--color-background) 100%
      );
  }

  .hero__content {
    position: relative;
    z-index: 2;

    width: 100%;
    padding: 0 2rem 8rem;

    text-align: center;
  }

  .hero__eyebrow {
    margin-bottom: 0.75rem;

    color: var(--color-primary-dark);

    font-size: 0.7rem;
    font-weight: 500;

    letter-spacing: 0.35em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;

    color: var(--color-primary-dark);

    font-size: clamp(6rem, 24vw, 12rem);
    font-weight: 400;

    line-height: 0.72;
    letter-spacing: -0.04em;
  }

  .hero__line {
    width: 70px;
    height: 1px;

    margin: 2rem auto 1.25rem;

    background: var(--color-gold);
  }

  .hero__date {
    margin: 0;

    color: var(--color-text);

    font-size: 0.72rem;
    font-weight: 500;

    letter-spacing: 0.3em;
  }

  .hero__scroll {
    position: absolute;
    z-index: 3;

    bottom: 1.75rem;
    left: 50%;

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;

    transform: translateX(-50%);

    color: var(--color-primary-dark);

    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .hero__scroll i {
    position: relative;

    width: 1px;
    height: 36px;

    display: block;

    background: var(--color-primary-dark);
  }

  .hero__scroll i::after {
    content: "";

    position: absolute;

    bottom: 0;
    left: -3px;

    width: 7px;
    height: 7px;

    border-right: 1px solid var(--color-primary-dark);
    border-bottom: 1px solid var(--color-primary-dark);

    transform: rotate(45deg);
  }

  .hero__ornament {
    position: absolute;
    z-index: 2;

    width: 120px;
    height: 120px;

    border: 1px solid rgba(182, 155, 104, 0.55);
    border-radius: 50%;
  }

  .hero__ornament--top {
    top: -60px;
    right: -30px;
  }

  @keyframes heroZoom {
    from {
      transform: scale(1);
    }

    to {
      transform: scale(1.05);
    }
  }

  @media (min-width: 768px) {
    .hero {
      align-items: center;
    }

    .hero__image {
      width: 62%;
      right: 0;
      left: auto;

      clip-path: polygon(
        12% 0,
        100% 0,
        100% 100%,
        0 100%
      );
    }

    .hero__veil {
      background:
        linear-gradient(
          90deg,
          var(--color-background) 0%,
          rgba(248, 245, 239, 0.95) 35%,
          rgba(248, 245, 239, 0) 72%
        );
    }

    .hero__content {
      position: relative;
      z-index: 3;

      width: 55%;
      margin-right: auto;
      padding: 0 0 0 8vw;

      text-align: left;
    }

    h1 {
      font-size: clamp(8rem, 15vw, 14rem);
    }

    .hero__line {
      margin-left: 0;
    }

    .hero__scroll {
      left: 8vw;

      transform: none;
    }
  }
</style>